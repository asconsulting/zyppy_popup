<?php if ($this->popup): ?>
<div class="popup_frame pre_init<?php echo ($this->popupUuid ? ' popup_' .$this->popupUuid : '') ?><?php echo ($this->popupClass ? ' ' .$this->popupClass : '') ?>"<?php echo ($this->popupUuid ? ' data-puid="' .$this->popupUuid .'"' : '') ?><?php echo ($this->popupDelay ? ' data-pdelay="' .$this->popupDelay .'"' : '') ?><?php echo ($this->popupReshowDelay ? ' data-rdelay="' .$this->popupReshowDelay .'"' : '') ?><?php echo ($this->popupScrollTrigger ? ' data-strigger="' .$this->popupScrollTrigger .'"' : '') ?><?php echo ($this->popupFadeDuration ? ' data-fduration="' .$this->popupFadeDuration .'"' : '') ?><?php echo ($this->popupTrigger ? ' data-ptrigger="' .$this->popupTrigger .'"' : '') ?><?php echo ($this->popupRejectUrl ? ' data-rejecturl="' .$this->popupRejectUrl .'"' : '') ?>>
<div class='popup_inside<?php echo ($this->popupClass ? ' ' .$this->popupClass : '') ?>'>
<?php if ($this->popupAddClose): ?><button class='close' href='#'>Close</button><?php endif; ?>
<?php endif; ?>	
<?php echo $this->body; ?>
<?php if ($this->popup): ?>
</div>
</div>
<?php endif; ?>	