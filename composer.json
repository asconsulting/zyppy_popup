{
    "name":"asconsulting/zyppy_popup",
    "description":"A popup Module for Contao 5.3+",
    "homepage": "https://andrewstevens.consulting",
    "keywords":["contao", "popup", "pop-up", "overlay"],
    "type":"contao-bundle",
    "license":"LGPL-3.0-or-later",
    "authors":[
        {
            "name":"Andrew Stevens",
            "homepage":"https://andrewstevens.consulting"
        }
    ],
    "require":{
        "php": ">=8.1",
        "contao/core-bundle": "^5.3",
        "codefog/contao-haste": "^5.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ZyppyPopup\\": "src/"
        }
    },
	"extra": {
		"contao-manager-plugin": "ZyppyPopup\\ContaoManager\\Plugin"
	},
    "minimum-stability": "dev"
}